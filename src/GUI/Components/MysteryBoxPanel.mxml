        <mx:Canvas id="box" styleName="detailsContentBox" left="8" right="8" top="92" bottom="112">
            <mx:Canvas id="innerBox" left="12" right="12" top="5" bottom="5" backgroundSize="100%"
                horizontalScrollPolicy="off" verticalScrollPolicy="auto">
                <mx:Tile id="itemsList" left="0" right="18" top="5" horizontalGap="5" verticalGap="5" horizontalAlign="center" direction="horizontal" />
            </mx:Canvas>
            <gui:SpriteLibAnimation id="busyAnim" animationName="guianim_hourglass"
                loop="true" visible="false" width="48" height="48" horizontalCenter="4" verticalCenter="4" />
