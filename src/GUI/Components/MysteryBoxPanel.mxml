<?xml version="1.0" encoding="utf-8"?>
<mx:Canvas xmlns:mx="http://www.adobe.com/2006/mxml" xmlns:gui="GUI.Components.*"
    width="428" height="345" clipContent="false" cacheAsBitmap="true">
    <mx:Script><![CDATA[
        import mx.effects.Fade;
        import mx.events.EffectEvent;
        import mx.events.FlexEvent;
        import GUI.Assets.gAssetManager;
        import flash.events.Event;
        import flash.events.MouseEvent;
        import flash.geom.Point;
        import flash.geom.Rectangle;

        private static const MIN_MYSTERY_BOX_WIDTH:Number = 428;
        private static const MIN_MYSTERY_BOX_HEIGHT:Number = 345;
        private var resizeStartMouseX:Number;
        private var resizeStartMouseY:Number;
        private var resizeStartWidth:Number;
        private var resizeStartHeight:Number;
        private var resizeActive:Boolean = false;
        private var dragActive:Boolean = false;

        public var fadeIn:Fade;
        public var fadeOut:Fade;

        public function __fadeOut_effectEnd(event:EffectEvent):void
        {
            globalFlash.gui.ShowQuestWindowDelayed();
        }

        override protected function childrenCreated():void
        {
            super.childrenCreated();
            fadeIn = new Fade();
            fadeIn.alphaFrom = 0;
            fadeIn.alphaTo = 1;
            fadeIn.duration = 150;
            fadeOut = new Fade();
            fadeOut.alphaFrom = 1;
            fadeOut.alphaTo = 0;
            fadeOut.duration = 150;
            fadeOut.addEventListener("effectEnd", __fadeOut_effectEnd);
            LegacyMxmlContent.createChildren(content);
            LegacyMxmlContent.createChildren(box);
            LegacyMxmlContent.createChildren(innerBox);
            LegacyMxmlContent.createChildren(subBox);
            setStyle("showEffect", fadeIn);
            setStyle("hideEffect", fadeOut);
            ornament.source = gAssetManager.GetBitmap("DailyLoginHeaderOrnamental");
            innerBox.setStyle("backgroundImage", ornamentalEmbed);
            addEventListener(MouseEvent.MOUSE_DOWN, startDragPanel, false, 0, true);
            addEventListener(FlexEvent.CREATION_COMPLETE, activateResizeHandle, false, 0, true);
        }

        private function startDragPanel(event:MouseEvent):void
        {
            if (((stage == null) || (resizeActive))) return;
            var localPoint:Point = globalToLocal(new Point(event.stageX, event.stageY));
            if (((localPoint.y < 0) || (localPoint.y > 30))) return;
            var currentX:Number = x;
            var currentY:Number = y;
            clearStyle("horizontalCenter");
            clearStyle("verticalCenter");
            x = currentX;
            y = currentY;
            dragActive = true;
            startDrag(false, new Rectangle(0, 0, Math.max(0, stage.stageWidth - width), Math.max(0, stage.stageHeight - height)));
            stage.addEventListener(MouseEvent.MOUSE_UP, stopDragPanel, false, 0, true);
            stage.addEventListener(Event.MOUSE_LEAVE, stopDragPanel, false, 0, true);
        }

        private function stopDragPanel(event:Event = null):void
        {
            stopDrag();
            dragActive = false;
            if (stage == null) return;
            stage.removeEventListener(MouseEvent.MOUSE_UP, stopDragPanel);
            stage.removeEventListener(Event.MOUSE_LEAVE, stopDragPanel);
        }

        private function activateResizeHandle(event:FlexEvent):void
        {
            removeEventListener(FlexEvent.CREATION_COMPLETE, activateResizeHandle);
            drawResizeHandle();
            resizeHandle.addEventListener(MouseEvent.MOUSE_DOWN, startResize, false, 0, true);
        }

        private function drawResizeHandle():void
        {
            resizeHandle.graphics.clear();
            resizeHandle.graphics.beginFill(0, 0);
            resizeHandle.graphics.drawRect(0, 0, 16, 16);
            resizeHandle.graphics.endFill();
            resizeHandle.graphics.lineStyle(4, 0x302719, 1);
            resizeHandle.graphics.moveTo(4, 15);
            resizeHandle.graphics.lineTo(15, 4);
            resizeHandle.graphics.moveTo(9, 15);
            resizeHandle.graphics.lineTo(15, 9);
            resizeHandle.graphics.lineStyle(2, 0xD6A94C, 1);
            resizeHandle.graphics.moveTo(4, 15);
            resizeHandle.graphics.lineTo(15, 4);
            resizeHandle.graphics.moveTo(9, 15);
            resizeHandle.graphics.lineTo(15, 9);
        }

        private function startResize(event:MouseEvent):void
        {
            event.stopImmediatePropagation();
            if (stage == null) return;
            resizeActive = true;
            resizeStartMouseX = event.stageX;
            resizeStartMouseY = event.stageY;
            resizeStartWidth = width;
            resizeStartHeight = height;
            stage.addEventListener(MouseEvent.MOUSE_MOVE, resizePanel, false, 0, true);
            stage.addEventListener(MouseEvent.MOUSE_UP, stopResize, false, 0, true);
            stage.addEventListener(Event.MOUSE_LEAVE, stopResize, false, 0, true);
        }

        private function resizePanel(event:MouseEvent):void
        {
            if (!resizeActive || stage == null) return;
            var maximumWidth:Number = Math.max(MIN_MYSTERY_BOX_WIDTH, stage.stageWidth - x);
            var maximumHeight:Number = Math.max(MIN_MYSTERY_BOX_HEIGHT, stage.stageHeight - y);
            width = Math.min(maximumWidth, Math.max(MIN_MYSTERY_BOX_WIDTH, resizeStartWidth + event.stageX - resizeStartMouseX));
            height = Math.min(maximumHeight, Math.max(MIN_MYSTERY_BOX_HEIGHT, resizeStartHeight + event.stageY - resizeStartMouseY));
            event.updateAfterEvent();
        }

        private function stopResize(event:Event = null):void
        {
            resizeActive = false;
            if (stage == null) return;
            stage.removeEventListener(MouseEvent.MOUSE_MOVE, resizePanel);
            stage.removeEventListener(MouseEvent.MOUSE_UP, stopResize);
            stage.removeEventListener(Event.MOUSE_LEAVE, stopResize);
        }

        [Embed(source="../../../assets/vector/embedded/mysterybox/mysterybox_ornamental_490.swf", symbol="GUI.Components.MysteryBoxPanel__embed_mxml_____data_src_gfx_embedded_mysterybox_ornamental_png_610377562")]
        private var ornamentalEmbed:Class;
    ]]></mx:Script>
